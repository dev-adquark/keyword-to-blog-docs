# Copy to .env.local for development. Never commit real secrets.

# --- Database (Postgres) ---
# Any standard Postgres connection string (Neon, Supabase, Vercel Postgres, RDS, etc.)
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Sessions ---
# Random 32+ byte secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# --- Content generation (Anthropic API) ---
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-5 if unset.
AI_MODEL=claude-sonnet-5

# --- Rate limiting (Upstash Redis, REST API — works from serverless functions) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Durable async jobs (Upstash QStash) ---
# Optional. If unset, POST /v1/jobs falls back to processing the job
# synchronously within the request instead of claiming a background worker
# that doesn't exist.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Public base URL ---
# Used to build the callback URL QStash calls back into, and for docs/SEO metadata.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
