# Copy to .env.local for development. Never commit real secrets.

# --- Database (Postgres) ---
# Any standard Postgres connection string (Neon, Supabase, Vercel Postgres, RDS, etc.).
# This must be a Postgres URL, not an Upstash Redis URL.
DATABASE_URL=redis-cli --tls -u redis://default:gQAAAAAAAdGnAAIgcDEyM2Q0NjA4MmMyZGU0NGEzODgzMWUzNmJmYmE0MjUyOQ@feasible-leech-119207.upstash.io:6379

# --- Sessions ---
# Random 32+ byte secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# --- Content generation (Anthropic API) ---
ANTHROPIC_API_KEY=
# Optional — defaults to Haiku (lowest token cost) if unset.
AI_MODEL=claude-haiku-4-5-20251001

# --- Rate limiting (Upstash Redis, REST API — works from serverless functions) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Durable async jobs (Upstash QStash) ---
# Optional. If unset, POST /v1/jobs falls back to processing the job
# synchronously within the request instead of claiming a background worker
# that doesn't exist.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Public base URL ---
# Used to build the callback URL QStash calls back into, and for docs/SEO metadata.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# --- Owner notification emails (Resend) ---
# Optional. If either is unset, owner notifications are a no-op — nothing
# fails, no email is sent. See lib/server/notifications.ts.
RESEND_API_KEY=
OWNER_NOTIFICATION_EMAIL=
# Optional — defaults to Resend's shared sender if unset (fine until you verify your own domain).
RESEND_FROM_EMAIL=onboarding@resend.dev
